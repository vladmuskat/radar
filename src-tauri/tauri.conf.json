{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RADAR Trainer",
  "version": "0.1.0",
  "identifier": "ru.radar.trainer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "РАДАР • Тренажёр оператора РЛС", "width": 1440, "height": 960, "minWidth": 1100, "minHeight": 720 }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost 'self'; worker-src 'self' blob:" }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png"] }
}
